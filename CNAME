<!-- Final Results Buttons -->
<div class="text-center mt-5 mb-4">
  <button class="btn btn-success mb-2" onclick="generateFinalResults()">Generate Final Results Only (PDF/Print)</button><br>
  <button class="btn btn-primary" onclick="copyFinalResults()">Copy All Results to Clipboard</button>
</div>

<script>
function generateFinalResults() {
  const outputs = document.querySelectorAll('.section-output');
  let finalContent = '';

  outputs.forEach(section => {
    if (section.innerHTML.trim() !== '') { // Only include non-empty outputs
      finalContent += section.innerHTML + '<br><br>';
    }
  });

  if (finalContent === '') {
    alert('No results generated yet. Please complete and generate outputs for tasks first.');
    return;
  }

  // Create a new printable window
  const printWindow = window.open('', '_blank', 'width=800,height=600');
  printWindow.document.write(`
    <html>
      <head>
        <title>PEERAMID2 - Final Results</title>
        <style>
          body {
            font-family: 'Roboto', sans-serif;
            padding: 40px;
            background: white;
            color: black;
          }
          h1 {
            text-align: center;
            margin-bottom: 30px;
          }
          div {
            margin-bottom: 20px;
          }
        </style>
      </head>
      <body>
        <h1>PEERAMID2 - Final Results Summary</h1>
        ${finalContent}
      </body>
    </html>
  `);
  printWindow.document.close();
  printWindow.focus();
  printWindow.print();
}

function copyFinalResults() {
  const outputs = document.querySelectorAll('.section-output');
  let finalText = '';

  outputs.forEach(section => {
    if (section.innerText.trim() !== '') { // Only include non-empty outputs
      finalText += section.innerText + '\n\n';
    }
  });

  if (finalText === '') {
    alert('No results to copy yet. Please complete and generate outputs for tasks first.');
    return;
  }

  // Create a temporary textarea to copy
  const textarea = document.createElement('textarea');
  textarea.value = finalText;
  document.body.appendChild(textarea);
  textarea.select();
  document.execCommand('copy');
  document.body.removeChild(textarea);

  alert('All results copied to clipboard!');
}
</script>
