    "Correct Features Recalled: " + correct + " out of 18 (" + accuracyPercent + "%)" + "<br>" +
    "Spatial Layout Score: " + layout + " out of 2" + "<br>" +
    "Proportionality Score: " + proportion + " out of 2" + "<br><br>" +
    "<strong>Automated Clinical Interpretation:</strong> " + interpretation + "<br><br>" +
    "<strong>Clinician Observations:</strong><br>" + observations;

  document.getElementById('complex_figure_output').innerHTML = output;
}
