<!-- SCRIPT SECTION -->
<script>
// Toggle Instructions Button Text
function toggleSection(id, button) {
  const el = document.getElementById(id);
  if (el.style.display === 'none' || el.style.display === '') {
    el.style.display = 'block';
    button.innerText = "Hide Instructions";
  } else {
    el.style.display = 'none';
    button.innerText = "Show Instructions";
  }
}

// Correctly Ordered Forward Items
const forwardItems = [
  "52", "73", "16", "72", "94",         // 2 digits
  "971", "615", "521", "648", "836",     // 3 digits
  "5318", "3741", "7596",                // 4 digits
  "41839", "63258", "92483",              // 5 digits (highlight!)
  "849713", "641397", "438975",           // 6 digits
  "3197426", "9251638", "7145283",        // 7 digits
  "46359271", "97412536", "49273165",     // 8 digits
  "928137546", "824791365", "475182369"   // 9 digits
];
const backwardItems = forwardItems;

// Generate Forward Inputs
const forwardSpanList = document.getElementById('forward_span_list');
forwardItems.forEach((item, idx) => {
  const highlightClass = (item.length === 5) ? 'highlight-average' : '';

  forwardSpanList.innerHTML += `
    <div class="col-md-4 mb-3">
      <div class="border p-2 rounded ${highlightClass}">
        <strong>Item ${idx + 1}: ${item}</strong><br>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="forward_correct_${idx}" onchange="enforceSingleCheckbox('forward', ${idx})">
          <label class="form-check-label" for="forward_correct_${idx}">Correct</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="forward_incorrect_${idx}" onchange="enforceSingleCheckbox('forward', ${idx})">
          <label class="form-check-label" for="forward_incorrect_${idx}">Incorrect</label>
        </div>
      </div>
    </div>
  `;
});

// Generate Backward Inputs
const backwardSpanList = document.getElementById('backward_span_list');
backwardItems.forEach((item, idx) => {
  const highlightClass = (item.length === 5) ? 'highlight-average' : '';

  backwardSpanList.innerHTML += `
    <div class="col-md-4 mb-3">
      <div class="border p-2 rounded ${highlightClass}">
        <strong>Item ${idx + 1}: ${item.split('').reverse().join('')}</strong><br>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="backward_correct_${idx}" onchange="enforceSingleCheckbox('backward', ${idx})">
          <label class="form-check-label" for="backward_correct_${idx}">Correct</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="backward_incorrect_${idx}" onchange="enforceSingleCheckbox('backward', ${idx})">
          <label class="form-check-label" for="backward_incorrect_${idx}">Incorrect</label>
        </div>
      </div>
    </div>
  `;
});

// Prevent double-checking both Correct and Incorrect
function enforceSingleCheckbox(type, idx) {
  const correct = document.getElementById(`${type}_correct_${idx}`);
  const incorrect = document.getElementById(`${type}_incorrect_${idx}`);
  
  if (correct.checked && incorrect.checked) {
    if (event.target.id.includes('correct')) {
      incorrect.checked = false;
    } else {
      correct.checked = false;
    }
  }
}

// Score Task
function scoreDigitSpan() {
  let forwardMaxSpan = 0;
  let backwardMaxSpan = 0;
  let consecutiveForwardFailures = 0;
  let consecutiveBackwardFailures = 0;

  // Forward Scoring
  for (let i = 0; i < forwardItems.length; i++) {
    const correctChecked = document.getElementById(`forward_correct_${i}`).checked;
    const incorrectChecked = document.getElementById(`forward_incorrect_${i}`).checked;

    if (correctChecked) {
      forwardMaxSpan = forwardItems[i].length;
      consecutiveForwardFailures = 0;
    } else if (incorrectChecked) {
      consecutiveForwardFailures++;
      if (consecutiveForwardFailures >= 2) break;
    } else {
      consecutiveForwardFailures++;
      if (consecutiveForwardFailures >= 2) break;
    }
  }

  // Backward Scoring
  for (let i = 0; i < backwardItems.length; i++) {
    const correctChecked = document.getElementById(`backward_correct_${i}`).checked;
    const incorrectChecked = document.getElementById(`backward_incorrect_${i}`).checked;

    if (correctChecked) {
      backwardMaxSpan = backwardItems[i].length;
      consecutiveBackwardFailures = 0;
    } else if (incorrectChecked) {
      consecutiveBackwardFailures++;
      if (consecutiveBackwardFailures >= 2) break;
    } else {
      consecutiveBackwardFailures++;
      if (consecutiveBackwardFailures >= 2) break;
    }
  }

  // Interpretation
  function interpretSpan(span) {
    if (span >= 9) return "Exceptional working memory span.";
    if (span >= 7) return "Above average working memory span.";
    if (span >= 5) return "Average working memory span.";
    return "Below expected working memory span.";
  }

  const forwardInterpret = interpretSpan(forwardMaxSpan);
  const backwardInterpret = interpretSpan(backwardMaxSpan);

  const observations = document.getElementById('digit_span_notes').value.trim();

  const output =
    "Task: Digit Span (Forward and Backward)" + "<br><br>" +
    "<strong>Forward Span:</strong> " + forwardMaxSpan + " digits" + "<br>" +
    "Forward Interpretation: " + forwardInterpret + "<br><br>" +
    "<strong>Backward Span:</strong> " + backwardMaxSpan + " digits" + "<br>" +
    "Backward Interpretation: " + backwardInterpret + "<br><br>" +
    "<strong>Clinician Observations:</strong><br>" + observations;

  document.getElementById('digit_span_output').innerHTML = output;
}
</script>
